{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tracelens",
  "version": "0.1.0",
  "identifier": "com.tracelens.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage", "deb", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["segy", "sgy"],
        "name": "SEG-Y Seismic Data",
        "description": "SEG-Y seismic data file",
        "mimeType": "application/x-segy",
        "role": "Viewer"
      }
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/com.tracelens.desktop.xml": "../flatpak/com.tracelens.desktop.mime.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/mime/packages/com.tracelens.desktop.xml": "../flatpak/com.tracelens.desktop.mime.xml"
        }
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TraceLens",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/tasansal/tracelens/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2NDIzNDA0NTdBRjlDNzkKUldSNW5LOVhCRFJDUnZaSWhnVUVEcC8vWUNpVERqMDVnZXVNaHJLak56OENoWUxqdjNkc0hILy8K"
    }
  }
}
